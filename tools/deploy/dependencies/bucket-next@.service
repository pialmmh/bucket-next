# bucket-next — one instance per shard: bucket-next@<shard_id>.service
# Config: /etc/bucket-next/shard-<shard_id>.yaml (rendered by tools/deploy/remote-deploy-v2.sh from config/tenants/<tenant>/<profile>/)
[Unit]
Description=bucket-next ID service (shard %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bucket-next
Group=bucket-next
ExecStart=/opt/bucket-next/bucket-next -config /etc/bucket-next/shard-%i.yaml
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

# Hardening. The state lives under /var/lib/bucket-next (systemd makes it, owned by the service user); the service
# writes nowhere else, and the unit holds no password.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
StateDirectory=bucket-next
StateDirectoryMode=0750
ReadWritePaths=/var/lib/bucket-next

[Install]
WantedBy=multi-user.target
