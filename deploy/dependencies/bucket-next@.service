# bucket-next — one instance per shard: bucket-next@<shard_id>.service
# Config: /etc/bucket-next/shard-<shard_id>.yaml (rendered by deploy.sh)
[Unit]
Description=bucket-next ID service (shard %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bucket-next
Group=bucket-next
ExecStart=/opt/bucket-next/bucket-next -config /etc/bucket-next/shard-%i.yaml
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/bucket-next

[Install]
WantedBy=multi-user.target
